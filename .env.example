# Copy to .env (or run `bun run onboard`, which writes it) and `chmod 600 .env`.
# The real .env is never committed.

# Identity — typed into application forms
APPLICANT_FULL_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_LOCATION=
APPLICANT_LINKEDIN=
APPLICANT_GITHUB=
APPLICANT_WEBSITE=

# Optional — only portals that force an account need it (none has an adapter yet)
APPLICANT_PASSWORD=

# Optional — national ID (Brazilian forms ask a CPF) and postal address.
# Typed only where a form requires them; masked in every report.
APPLICANT_CPF=
APPLICANT_ADDRESS_STREET=
APPLICANT_ADDRESS_DISTRICT=
APPLICANT_ADDRESS_CITY=
APPLICANT_ADDRESS_STATE=
APPLICANT_ADDRESS_POSTAL=
APPLICANT_ADDRESS_COUNTRY=

# Optional — IMAP access used ONLY to read emailed application security codes.
# Use an app password (Google: myaccount.google.com/apppasswords), never your own.
MAIL_IMAP_USER=
MAIL_APP_PASSWORD=

# Optional — shown to job boards in the bot's User-Agent so they can reach you.
CONTACT_EMAIL=
